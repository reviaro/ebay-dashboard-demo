#!/usr/bin/env bash
# Defense-in-depth guard for the staged tree, including force-added files.
# Enable after cloning: git config core.hooksPath scripts/git-hooks
# This heuristic does not replace review or hosted secret scanning.
set -euo pipefail

fail() {
  printf 'pre-commit: BLOCKED: %s\n\n  %s\n' "$1" "$2" >&2
  echo 'Nothing was committed. Remove the sensitive content from the index.' >&2
  exit 1
}

# NUL-delimited paths preserve spaces and newlines. Scan index contents even
# when the corresponding working-tree file has been changed or removed.
files=()
while IFS= read -r -d '' file; do files+=("$file"); done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#files[@]}" -eq 0 ] && exit 0

# The only environment file allowed is the sanitized root template. It still
# receives all content checks below, so populated template secrets are blocked.
for file in "${files[@]}"; do
  case "$file" in
    .env.example) ;;
    .env*|*/.env*) fail "staged environment file: $file" 'Environment files and backups must remain outside Git.' ;;
  esac
  case "$file" in
    *.db|*.db-*|*.db.*|*.sqlite|*.sqlite-*|*.sqlite.*|*.sqlite3|*.sqlite3-*|*.sqlite3.*)
      fail "staged database file: $file" 'Databases and sidecars can hold business data and encrypted tokens.' ;;
  esac
done

secret_keys='EBAY_CLIENT_SECRET|EBAY_RUNAME|EBAY_TOKEN_ENCRYPTION_KEY|DASHBOARD_PASSWORD_HASH|DASHBOARD_SESSION_SECRET|GOOGLE_API_KEY|EMILY_API_TOKEN'
for file in "${files[@]}"; do
  # Read exactly the staged blob. Match complete streams rather than grep -q:
  # with pipefail, an early grep exit can turn a true match into a SIGPIPE miss.
  # NUL bytes (binary files such as screenshots) become line breaks: bash
  # cannot hold NULs in a variable and would warn on every binary file.
  content=$(git show ":$file" | tr '\0' '\n') || fail "cannot inspect staged file: $file" 'Review the staged object before committing.'
  if grep -E "^[[:space:]]*(export[[:space:]]+)?($secret_keys)[[:space:]]*=[[:space:]]*[\"']?[^[:space:]\"'#]{12,}" <<< "$content" >/dev/null; then
    fail "possible credential assigned in $file" 'Use an empty template value and keep real credentials in ignored files.'
  fi
  if grep -E 'v\^1\.1#i\^1#[A-Za-z0-9#^+/=]{40,}' <<< "$content" >/dev/null; then
    fail "possible eBay OAuth token in $file" 'OAuth token payloads must not appear in source files.'
  fi
  if grep -E 'scrypt:[0-9]+:[0-9]+:[0-9]+:[A-Za-z0-9+/]{16,}={0,2}:' <<< "$content" >/dev/null; then
    fail "password hash in $file" 'Password hashes are offline-crackable; keep them in ignored environment files.'
  fi
  # The explicitly synthetic fixture marker is allowed; all other app-key
  # fragments receive review. Do not print the matching key or secret.
  keys=$(grep -oE '(PRD|SBX)-[a-f0-9]{8,}' <<< "$content" || true)
  if grep -Ev '^((PRD|SBX)-a1b2c3d4e5f6)?$' <<< "$keys" >/dev/null; then
    fail "possible eBay application key in $file" 'Tests must use the synthetic app-key marker.'
  fi
done
