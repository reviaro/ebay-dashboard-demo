# AI Agent — configure one or more providers (keys stay on the server).
# Optional default: gemini, openai, or anthropic.
# Blank picks the first configured provider in that order. Switch in the chat drawer.
AI_PROVIDER=

# Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.0-flash

# OpenAI API: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Claude API (Anthropic): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Database Configuration (SQLite)
# prisma/schema.prisma reads DATABASE_URL. Relative SQLite paths resolve from
# the prisma directory, so file:./dev.db creates prisma/dev.db.
# Use a new local database; never copy a production database into this clone.
DATABASE_URL="file:./dev.db"

# Environment
NODE_ENV=development

# Dev server only: hosts allowed to load dev assets when you browse from
# another machine (comma-separated hostnames or IPs). See next.config.js.
DEV_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# eBay API sync (read-only)
# ---------------------------------------------------------------------------
# Register the app and find these at https://developer.ebay.com/my/keys
# Reporting syncs remain read-only. Listing creation is separately gated by
# the store write switch, user role, and (in production) the flag below.
# Leave this false unless live publishing for a verified seller is intended.
EBAY_LISTING_WRITES_ENABLED=false

# Optional durable private photo directory; default .data/listing-assets.
# LISTING_ASSET_DIR=/absolute/path/to/private/listing-assets

# Sample configuration uses sandbox; this does not implement demo isolation.
# Leave all integration credentials empty for source review.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# The RuName (eBay redirect URL name) from your application keyset -- this is
# the RuName token itself, NOT the https URL it points at. eBay's authorization
# URL takes it as the `redirect_uri` parameter.
EBAY_RUNAME=

# Primary marketplace for API requests.
EBAY_MARKETPLACE_ID=EBAY_US

# AES-256-GCM key protecting the refresh token at rest. Generate with:
#   openssl rand -base64 32
# Rotation is additive -- keep old versions so existing rows stay readable:
#   EBAY_TOKEN_ENCRYPTION_KEY="v1:<old base64 key>,v2:<new base64 key>"
# Back this up: losing it means re-authorizing the eBay connection.
EBAY_TOKEN_ENCRYPTION_KEY=

# NOTE: there is deliberately no EBAY_REFRESH_TOKEN here. The refresh token is
# stored encrypted in the database, never in a file on disk.

# ---------------------------------------------------------------------------
# Dashboard authentication
# ---------------------------------------------------------------------------
# The dashboard has a single operator and no user accounts. Both values below
# are REQUIRED: if either is missing the app denies every request rather than
# serving unauthenticated (see src/lib/auth/config.ts).
#
# Set both at once with:
#   npm run auth:hash
# which prompts for a password (echo suppressed), writes .env.local, and
# generates a session secret if one is not already set.
#
# Where there is no usable terminal (an agent harness, CI, a non-interactive
# shell), write the password into a file with an editor and use:
#   npm run auth:hash -- --from-file /path/to/file
# The file is securely deleted afterwards. Do NOT create it with `echo`, which
# would put the password in your shell history.
#
# Authentication settings are read at runtime. Restart the app after changes.

# scrypt hash of the operator password. Never the password itself.
# Format: scrypt:<N>:<r>:<p>:<saltBase64>:<hashBase64>
# The separator is ":" not "$" on purpose -- dotenv expands $NAME inside values
# in every quoting style, which would silently corrupt the hash.
DASHBOARD_PASSWORD_HASH=

# HMAC key signing session cookies. At least 32 bytes.
#   openssl rand -base64 32
# Rotating this invalidates every outstanding session immediately.
DASHBOARD_SESSION_SECRET=

# Optional. How long a session lasts before re-login. Default 720 (30 days).
DASHBOARD_SESSION_TTL_HOURS=720

# Optional exact reverse-proxy socket IPs, comma separated. Never use CIDRs,
# hostnames, all clients, or a whole LAN. Empty = ignore all forwarded addresses.
# A trusted proxy must overwrite or append X-Forwarded-For with the observed
# client address. Chains are checked from the socket inward; only listed hops
# are trusted. Configure this before serving multiple clients through a proxy,
# or those clients share the proxy's login-failure limit. Direct clients use
# their actual socket IP. Invalid configuration fails closed for login.
# Configure addresses privately; restart after changing this setting.
DASHBOARD_TRUSTED_PROXY_IPS=

# Bootstrap-only legacy agent token, imported as a hashed key for Store 1.
# Manage new keys per store in Settings. Agent URLs require ?store=<store-id>.
# This environment variable is not checked at runtime.
EMILY_API_TOKEN=

# Initial owner username, used only by npm run auth:bootstrap.
DASHBOARD_OWNER_USERNAME=owner

# Optional cookie override for multiple instances on one hostname.
# Defaults: dashboard_dev_session for sandbox, dashboard_session for production.
# DASHBOARD_COOKIE_NAME=dashboard_dev_session

# ---------------------------------------------------------------------------
# Store goals (optional)
# ---------------------------------------------------------------------------
# Shown on the dashboard and in /api/reports. Defaults: 10000 and 0.10.
# Inlined at build time: rebuild after changing them.
NEXT_PUBLIC_TARGET_REVENUE=
NEXT_PUBLIC_TARGET_INTERNATIONAL_SHARE=
