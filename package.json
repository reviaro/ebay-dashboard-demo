{
  "name": "ebay-dashboard",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "next dev -p 3940",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "auth:hash": "node --import ./scripts/ts-resolver.mjs scripts/hash-password.ts",
    "sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/ts-resolver.mjs scripts/sync-due.ts",
    "auth:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/ts-resolver.mjs scripts/bootstrap-owner.ts",
    "listings:work": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/ts-resolver.mjs scripts/listing-worker.ts",
    "auth:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/ts-resolver.mjs scripts/reset-user.ts",
    "seed:demo": "DATABASE_URL=file:./demo.db node --import ./scripts/ts-resolver.mjs scripts/seed-demo.ts",
    "demo:answers": "DATABASE_URL=file:./demo.db node --import ./scripts/ts-resolver.mjs scripts/build-demo-answers.ts",
    "demo:build": "DEMO_MODE=1 DATABASE_URL=file:./demo.db NEXT_TELEMETRY_DISABLED=1 next build",
    "demo:start": "DEMO_MODE=1 DATABASE_URL=file:./demo.db NEXT_TELEMETRY_DISABLED=1 next start -p 3941 -H ${DEMO_HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "test:demo:http": "DATABASE_URL=file:./demo.db node scripts/smoke-demo.mjs",
    "test:auth:http": "node --import ./scripts/ts-resolver.mjs scripts/smoke-auth.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@types/pdf-parse": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.474.0",
    "next": "^16.3.0",
    "node-html-parser": "^7.0.2",
    "papaparse": "^5.5.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.35",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
